\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{fstdiss}[2026/06/02 FST thesis package]

% Declare options --------------------------------------------------------------
\newif\ifaccepted
\newif\ifdraft

% Declare options 
\DeclareOption{accepted}{\acceptedtrue}
\DeclareOption{draft}{\drafttrue}
\DeclareOption{manuscript}{\acceptedfalse}

% Process options --------------------------------------------------------------
\ExecuteOptions{manuscript}
\ProcessOptions\relax

% Package loading --------------------------------------------------------------
\ifdraft
  \RequirePackage{xparse}
  \RequirePackage{layouts}
  \RequirePackage{todonotes}

  \presetkeys{todonotes}{color=white, bordercolor=red, linecolor=black}{}

  \newcount\loglevel
    \loglevel=2

  \newcommand{\IfLogLevelAtLeast}[2]{%
    \ifnum\loglevel<#1\relax
      % do nothing
    \else
      #2%
    \fi
  }

  \newcommand{\feedback}[2]{%
    \IfLogLevelAtLeast{1}{\TodoNotesTodo[prepend, caption={\textbf{@#1}}, color=green!40, bordercolor=black, linecolor=black]{#2}}
  }
  
  % Keep the real \todo from todonotes, but gate it by loglevel>=1
  \let\TodoNotesTodo\todo
  \RenewDocumentCommand{\todo}{O{}m}{%
    \IfLogLevelAtLeast{1}{\TodoNotesTodo[#1]{#2}}%
  }

  % note macro: gated by loglevel>=2
  \NewDocumentCommand{\note}{O{}m}{%
    \IfLogLevelAtLeast{2}{%
      \TodoNotesTodo[
        color=yellow!40,
        linecolor=black,
        bordercolor=black,
        prepend,
        caption={\textbf{Note}},
        #1
      ]{#2}%
    }%
  }
\else
  \NewDocumentCommand{\todo}{O{}m}{}%
  \NewDocumentCommand{\feedback}{O{}m}{}%
  \NewDocumentCommand{\note}{O{}m}{}%
\fi

% Default package loading
\RequirePackage{lmodern}
\RequirePackage{xstring}
\RequirePackage[datesep=.,ngerman,british]{datetime2}
