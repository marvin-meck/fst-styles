\newcommand*{\submissiondate}[1]{%
  \DTMsavedate{submission}{#1}
  \DTMmakeglobal{submission}
  \gdef\@submissiondate{\DTMusedate{submission}}
}
\newcommand*{\@submissiondate}{\texttt{\string\submissiondate} currently not set. Please fix this.}

\newcommand*{\dateofexam}[1]{
