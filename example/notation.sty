\RequirePackage{amsfonts}   % \mathbb
\RequirePackage{mathtools}  % \coloneqq
\RequirePackage{ifthen}

% Symbols
\RequirePackage[
  record=nameref,
  abbreviations,
  symbols,
  section=section,
  toc=false,
]{glossaries-extra}

\RequirePackage{multicol}
\RequirePackage{fstglossaries}

\setabbreviationstyle{long-short-user}
\renewcommand{\GlsXtrFmtDefaultOptions}{} % see bib2gls manual p. 441

\newglossary*{scripts}{Sub- and superscripts}

\GlsXtrLoadResources[
  src={symbols},
  type={symbols},
  field-aliases={format=user1, dimension=user2, value=user3, reference=user4},
]

\GlsXtrLoadResources[
  src={scripts},
  type={scripts},
  field-aliases={format=user1, dimension=user2, value=user3, reference=user4}
]

\GlsXtrLoadResources[
  src={abbreviations},
  type={abbreviations}
]

% Operators and math notation
\DeclareMathAlphabet{\mathup}{OT1}{\familydefault}{m}{n} % from https://tex.stackexchange.com/a/98011

% Units
\RequirePackage{siunitx}
\sisetup{
  group-digits=integer,
  exponent-product=\cdot,
  per-mode=symbol,
  display-per-mode=power-positive-first,
  inline-per-mode=power-positive-first,
  qualifier-mode=bracket,
  table-alignment=right,
}

% Macros
\RequirePackage{scripts}
\RequirePackage{symbols}
